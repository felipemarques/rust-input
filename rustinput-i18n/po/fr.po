msgstr "Fenêtres claires ou sombres, sur cet ordinateur"

#: rustinput-gtk/resources/window.ui:524
msgid "As the system"
msgstr "Comme le système"

#: rustinput-gtk/resources/window.ui:525
msgid "Light"
msgstr "Clair"

#: rustinput-gtk/resources/window.ui:526
msgid "Dark"
msgstr "Sombre"

