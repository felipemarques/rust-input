msgstr "RustInput {version}: أقدم من هذا ({local})، حدّثه"

#: rustinput-gtk/src/client_row.rs:298
msgid "RustInput {version}: newer than this one ({local})"
msgstr "RustInput {version}: أحدث من هذا ({local})"

#: rustinput-gtk/src/client_row.rs:313
