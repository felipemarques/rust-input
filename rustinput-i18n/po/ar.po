msgstr "استلام {size} من {name}؟"

#: rustinput-gtk/src/ask_transfer.rs:43
msgid "{count} file copied on {name} came along with the pointer. It waits in the temporary folder until you paste it."
msgid_plural "{count} files copied on {name} came along with the pointer. They wait in the temporary folder until you paste them."
msgstr[0] "{count} ملف نُسخت على {name} وجاءت مع المؤشر. تنتظر في المجلد المؤقت حتى تلصقها."
msgstr[1] "ملف واحد نُسخ على {name} وجاء مع المؤشر. ينتظر في المجلد المؤقت حتى تلصقه."
msgstr[2] "ملفان نُسخا على {name} وجاءا مع المؤشر. ينتظران في المجلد المؤقت حتى تلصقهما."
msgstr[3] "{count} ملفات نُسخت على {name} وجاءت مع المؤشر. تنتظر في المجلد المؤقت حتى تلصقها."
msgstr[4] "{count} ملفًا نُسخت على {name} وجاءت مع المؤشر. تنتظر في المجلد المؤقت حتى تلصقها."
msgstr[5] "{count} ملف نُسخت على {name} وجاءت مع المؤشر. تنتظر في المجلد المؤقت حتى تلصقها."

