msgstr "إصداره: {peer} · هذا الكمبيوتر: {local}"

#: rustinput-gtk/src/introduction.rs:43
msgid "Authorize {name} here too?"
msgstr "منح الإذن لـ {name} هنا أيضًا؟"

#: rustinput-gtk/src/introduction.rs:49
msgid "{by} was paired with {name}. Authorized here too, the two can control each other and share the clipboard and files. Compare the fingerprint with the one {name} shows."
msgstr "اقترن {by} بـ {name}. إن مُنح الإذن هنا أيضًا، يمكن للاثنين التحكم أحدهما بالآخر ومشاركة الحافظة والملفات. قارن البصمة بالتي يعرضها {name}."

#: rustinput-gtk/src/introduction.rs:65
msgid "Not now"
msgstr "ليس الآن"

#: rustinput-gtk/src/introduction.rs:106
msgid "Authorize a computer?"
msgstr "منح الإذن لكمبيوتر؟"

#: rustinput-gtk/src/lib.rs:269
msgid "Quit"
msgstr "إنهاء"

#: rustinput-gtk/src/lib.rs:270
msgid "_File"
msgstr "_ملف"

#: rustinput-gtk/src/lib.rs:498
msgid "{name} and this computer authorized each other"
msgstr "تم التخويل المتبادل بين {name} وهذا الكمبيوتر"

#: rustinput-gtk/src/lib.rs:503
msgid "Not authorized: {error}"
msgstr "لم يتم التخويل: {error}"

#: rustinput-gtk/src/lib.rs:510
