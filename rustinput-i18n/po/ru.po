#: rustinput-gtk/src/ask_transfer.rs:34
msgid "Receive {size} from {name}?"
msgstr "Получить {size} с {name}?"

#: rustinput-gtk/src/ask_transfer.rs:43
msgid "{count} file copied on {name} came along with the pointer. It waits in the temporary folder until you paste it."
msgid_plural "{count} files copied on {name} came along with the pointer. They wait in the temporary folder until you paste them."
msgstr[0] "{count} файл, скопированный на {name}, пришёл вместе с указателем. Он ждёт во временной папке, пока вы его не вставите."
msgstr[1] "{count} файла, скопированные на {name}, пришли вместе с указателем. Они ждут во временной папке, пока вы их не вставите."
msgstr[2] "{count} файлов, скопированных на {name}, пришли вместе с указателем. Они ждут во временной папке, пока вы их не вставите."

