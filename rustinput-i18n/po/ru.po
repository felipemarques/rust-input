#: rustinput-gtk/resources/authorization_window.ui:11
msgid "Computer not authorized"
msgstr "Компьютер не авторизован"

#: rustinput-gtk/resources/authorization_window.ui:33
msgid "A computer that is not authorized is trying to connect. Do you want to authorize it?"
msgstr "Неавторизованный компьютер пытается подключиться. Авторизовать его?"

#: rustinput-gtk/resources/authorization_window.ui:41
msgid "SHA-256 fingerprint"
msgstr "Отпечаток SHA-256"

#: rustinput-gtk/resources/authorization_window.ui:71
msgid "Or, on the computer that is trying to connect, open RustInput, click “Enter code…” next to this computer and enter:"
msgstr "Или на компьютере, который пытается подключиться, откройте RustInput, нажмите «Ввести код…» рядом с этим компьютером и введите:"

#: rustinput-gtk/resources/authorization_window.ui:86
msgid "That authorizes both computers on each other."
msgstr "Так оба компьютера будут взаимно авторизованы."

#: rustinput-gtk/resources/authorization_window.ui:111
msgid "Cancel"
msgstr "Отмена"

#: rustinput-gtk/resources/authorization_window.ui:120
msgid "Authorize"
msgstr "Авторизовать"

#: rustinput-gtk/resources/client_row.ui:10
msgid "Use this computer"
msgstr "Использовать этот компьютер"

#: rustinput-gtk/resources/client_row.ui:31
msgid "Look up its address again"
msgstr "Снова определить его адрес"

#: rustinput-gtk/resources/client_row.ui:87
msgid "Address"
msgstr "Адрес"

#: rustinput-gtk/resources/client_row.ui:88
msgid "Name or IP, and port"
msgstr "Имя или IP и порт"

#: rustinput-gtk/resources/client_row.ui:95
msgid "Name or address"
msgstr "Имя или адрес"

#: rustinput-gtk/resources/client_row.ui:116
msgid "Position"
msgstr "Положение"

#: rustinput-gtk/resources/client_row.ui:117
msgid "The edge of this screen that leads to it"
msgstr "Край этого экрана, ведущий к нему"

#: rustinput-gtk/resources/client_row.ui:133
msgid "Authorize with a code"
msgstr "Авторизовать по коду"

#: rustinput-gtk/resources/client_row.ui:134
msgid "The other computer shows a code when this one tries to connect: entering it here authorizes both computers on each other"
msgstr "Когда этот компьютер пытается подключиться, другой показывает код: ввод кода здесь взаимно авторизует оба компьютера"

#: rustinput-gtk/resources/client_row.ui:137
msgid "Enter code…"
msgstr "Ввести код…"

#: rustinput-gtk/resources/client_row.ui:146
msgid "Remove this computer"
msgstr "Удалить этот компьютер"

#: rustinput-gtk/resources/fingerprint_window.ui:11
msgid "Authorize a computer by its fingerprint"
msgstr "Авторизовать компьютер по отпечатку"

#: rustinput-gtk/resources/fingerprint_window.ui:27
msgid "The certificate fingerprint serves as a unique identifier for your device."
msgstr "Отпечаток сертификата служит уникальным идентификатором вашего устройства."

#: rustinput-gtk/resources/fingerprint_window.ui:32
msgid "On the other computer, RustInput shows it under “This computer” on the Computers page"
msgstr "На другом компьютере RustInput показывает его в разделе «Этот компьютер» на странице «Компьютеры»"

#: rustinput-gtk/resources/fingerprint_window.ui:37
msgid "Description"
msgstr "Описание"

#: rustinput-gtk/resources/fingerprint_window.ui:84
msgid "Confirm"
msgstr "Подтвердить"

#: rustinput-gtk/resources/key_row.ui:8
msgid "Revoke the authorization"
msgstr "Отозвать авторизацию"

#: rustinput-gtk/resources/window.ui:23
msgid "_Close window"
msgstr "_Закрыть окно"

#: rustinput-gtk/resources/window.ui:27
msgid "_Quit RustInput"
msgstr "_Выйти из RustInput"

#: rustinput-gtk/resources/window.ui:69
msgid "Version and commit"
msgstr "Версия и коммит"

#: rustinput-gtk/resources/window.ui:79
msgid "Menu"
msgstr "Меню"

#: rustinput-gtk/resources/window.ui:85
msgid "Pause RustInput"
msgstr "Приостановить RustInput"

#: rustinput-gtk/resources/window.ui:106
msgid "RustInput is paused: the mouse and keyboard stay on this computer, and no other computer controls it."
msgstr "RustInput приостановлен: мышь и клавиатура остаются на этом компьютере, и никакой другой компьютер им не управляет."

#: rustinput-gtk/resources/window.ui:115
msgid "Resume"
msgstr "Возобновить"

#: rustinput-gtk/resources/window.ui:175
msgid "Computers"
msgstr "Компьютеры"

#: rustinput-gtk/resources/window.ui:206
msgid "This computer"
msgstr "Этот компьютер"

#: rustinput-gtk/resources/window.ui:207
msgid "What the other computers need to reach this one"
msgstr "Что нужно другим компьютерам, чтобы подключиться к этому"

#: rustinput-gtk/resources/window.ui:210
msgid "Name"
msgstr "Имя"

#: rustinput-gtk/resources/window.ui:219
msgid "Copy the name"
msgstr "Копировать имя"

#: rustinput-gtk/resources/window.ui:226
msgid "The name of this computer is not known"
msgstr "Имя этого компьютера неизвестно"

#: rustinput-gtk/resources/window.ui:246
msgid "Port"
msgstr "Порт"

#: rustinput-gtk/resources/window.ui:247
msgid "UDP and TCP"
msgstr "UDP и TCP"

#: rustinput-gtk/resources/window.ui:263
msgid "Port, 4242 when empty"
msgstr "Порт; если пусто — 4242"

#: rustinput-gtk/resources/window.ui:273
msgid "Use this port"
msgstr "Использовать этот порт"

#: rustinput-gtk/resources/window.ui:284
msgid "Keep the port"
msgstr "Оставить прежний порт"

#: rustinput-gtk/resources/window.ui:292
msgid "Certificate fingerprint"
msgstr "Отпечаток сертификата"

#: rustinput-gtk/resources/window.ui:302
msgid "Copy the fingerprint"
msgstr "Копировать отпечаток"

#: rustinput-gtk/resources/window.ui:314
msgid "Status"
msgstr "Состояние"

#: rustinput-gtk/resources/window.ui:329
msgid "Reenable"
msgstr "Включить снова"

#: rustinput-gtk/resources/window.ui:382
msgid "Connections"
msgstr "Подключения"

#: rustinput-gtk/resources/window.ui:383
msgid "Switch one on to use it; open it for its address and the code to authorize it."
msgstr "Включите подключение, чтобы использовать его; раскройте его, чтобы указать адрес и ввести код авторизации."

#: rustinput-gtk/resources/window.ui:388
msgid "Add a computer by its name or address"
msgstr "Добавить компьютер по имени или адресу"

#: rustinput-gtk/resources/window.ui:392
msgid "Add computer"
msgstr "Добавить компьютер"

#: rustinput-gtk/resources/window.ui:403
msgid "No computers yet"
msgstr "Компьютеров пока нет"

#: rustinput-gtk/resources/window.ui:404
msgid "Add one with “Add computer”, by its name or address"
msgstr "Добавьте компьютер по имени или адресу кнопкой «Добавить компьютер»"

#: rustinput-gtk/resources/window.ui:427
msgid "Arrangement"
msgstr "Расположение"

#: rustinput-gtk/resources/window.ui:447
msgid "Drag a computer next to another one, like monitors: the mouse crosses where they touch. Applying it sets up the other computers too."
msgstr "Перетащите компьютер к другому, как мониторы: мышь переходит там, где они соприкасаются. При применении настраиваются и другие компьютеры."

#: rustinput-gtk/resources/window.ui:466
msgid "Clipboards"
msgstr "Буферы обмена"

#: rustinput-gtk/resources/window.ui:484
msgid "What each computer has copied, kept up to date while this tab is open. “Copy here” puts it on the clipboard of this computer."
msgstr "Что скопировано на каждом компьютере; обновляется, пока открыта эта вкладка. «Скопировать сюда» помещает это в буфер обмена этого компьютера."

#: rustinput-gtk/resources/window.ui:510
msgid "Preferences"
msgstr "Параметры"

#: rustinput-gtk/resources/window.ui:516
msgid "Appearance"
msgstr "Внешний вид"

#: rustinput-gtk/resources/window.ui:519
msgid "Style"
msgstr "Стиль"

#: rustinput-gtk/resources/window.ui:520
msgid "Light or dark windows, on this computer"
msgstr "Светлые или тёмные окна на этом компьютере"

#: rustinput-gtk/resources/window.ui:524
msgid "As the system"
msgstr "Как в системе"

#: rustinput-gtk/resources/window.ui:525
msgid "Light"
msgstr "Светлый"

#: rustinput-gtk/resources/window.ui:526
msgid "Dark"
msgstr "Тёмный"

#: rustinput-gtk/resources/window.ui:534
msgid "Language"
msgstr "Язык"

#: rustinput-gtk/resources/window.ui:535
msgid "Of the windows, the menus and the radial menu, on this computer"
msgstr "Окон, меню и радиального меню на этом компьютере"

#: rustinput-gtk/resources/window.ui:542
msgid "Updates"
msgstr "Обновления"

#: rustinput-gtk/resources/window.ui:545
msgid "Look for new versions"
msgstr "Проверять наличие новых версий"

#: rustinput-gtk/resources/window.ui:546
msgid "Asks GitHub for the number of the latest version when RustInput starts and every 12 hours. Nothing about you or your computers is sent."
msgstr "Запрашивает у GitHub номер последней версии при запуске RustInput и каждые 12 часов. Никаких сведений о вас или ваших компьютерах не отправляется."

#: rustinput-gtk/resources/window.ui:557
msgid "Latest version"
msgstr "Последняя версия"

#: rustinput-gtk/resources/window.ui:569
msgid "Check now"
msgstr "Проверить сейчас"

#: rustinput-gtk/resources/window.ui:582
msgid "Show this clipboard to the other computers"
msgstr "Показывать этот буфер обмена другим компьютерам"

#: rustinput-gtk/resources/window.ui:583
msgid "In their Clipboards tab, to the computers authorized here, which can also copy it from there. Passwords marked by a password manager are never shown."
msgstr "На их вкладке «Буферы обмена», компьютерам, разрешённым здесь; оттуда его можно и скопировать. Пароли, отмеченные менеджером паролей, никогда не показываются."

#: rustinput-gtk/resources/window.ui:595
msgid "Keep a history of the copies"
msgstr "Хранить историю копирования"

#: rustinput-gtk/resources/window.ui:596
msgid "The last copies of this computer, in memory only: they are gone when RustInput closes. Passwords marked by a password manager are not kept."
msgstr "Последние копии этого компьютера, только в памяти: они исчезают при закрытии RustInput. Пароли, отмеченные менеджером паролей, не сохраняются."

#: rustinput-gtk/resources/window.ui:610
msgid "File transfers"
msgstr "Передача файлов"

#: rustinput-gtk/resources/window.ui:611
msgid "Copy files on one computer and paste them on another"
msgstr "Копируйте файлы на одном компьютере и вставляйте на другом"

#: rustinput-gtk/resources/window.ui:617
msgid "Allowed to connect"
msgstr "Разрешено подключаться"

#: rustinput-gtk/resources/window.ui:618
msgid "The computers whose certificate this one accepts. A computer that is not here asks first, with a code."
msgstr "Компьютеры, сертификат которых принимает этот. Компьютер, которого здесь нет, сначала запрашивает разрешение с кодом."

#: rustinput-gtk/resources/window.ui:637
msgid "No computers allowed yet"
msgstr "Пока нет разрешённых компьютеров"

#: rustinput-gtk/resources/window.ui:638
msgid "Authorize one with “Authorize”, or accept its request"
msgstr "Авторизуйте компьютер кнопкой «Авторизовать» или примите его запрос"

#: rustinput-gtk/resources/window.ui:655
msgid "About"
msgstr "О программе"

#: rustinput-gtk/resources/window.ui:660
