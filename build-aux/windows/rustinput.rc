// Resources of the Windows executable, compiled by build.rs.
// rc.exe runs from the repository root, paths are relative to it.

// RUSTINPUT_VERSION (0,20,1,0) and RUSTINPUT_VERSION_STR ("0.20.1"), written
// by build.rs from Cargo.toml into OUT_DIR, which embed-resource adds to the
// include path
#include "rustinput-version.h"

1 ICON "build-aux/windows/rustinput.ico"

// The version Explorer shows in the file properties, and that the update
// script (scripts/update-rustinput.ps1) compares with the newest release.
// FileDescription is also the name Task Manager shows.
1 VERSIONINFO
FILEVERSION RUSTINPUT_VERSION
PRODUCTVERSION RUSTINPUT_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
// VOS_NT_WINDOWS32, VFT_APP
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // U.S. English, Unicode
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RustInput"
            VALUE "FileDescription", "RustInput"
            VALUE "FileVersion", RUSTINPUT_VERSION_STR
            VALUE "InternalName", "rustinput"
            VALUE "LegalCopyright", "GPL-3.0-or-later. Based on lan-mouse by Ferdinand Schober and contributors"
            VALUE "OriginalFilename", "rustinput.exe"
            VALUE "ProductName", "RustInput"
            VALUE "ProductVersion", RUSTINPUT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
