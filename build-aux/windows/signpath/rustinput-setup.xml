<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "rustinput-setup" (DOC.md, "Signing the
  Windows files"): the installer, built with the signed rustinput.exe inside,
  uploaded alone, which GitHub zips.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="rustinput-windows-x86_64-setup.exe" product-name="RustInput" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
